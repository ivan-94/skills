#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  TARGET="$(readlink "$SOURCE")"
  if [[ "$TARGET" == /* ]]; then
    SOURCE="$TARGET"
  else
    SOURCE="$DIR/$TARGET"
  fi
done

SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
APP_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
INVOCATION_DIR="$PWD"
INITIAL_PATH="${1:-$INVOCATION_DIR}"
APP_BUNDLE="$APP_DIR/.build/AgentBoard.app"
CONTENTS_DIR="$APP_BUNDLE/Contents"
MACOS_DIR="$CONTENTS_DIR/MacOS"
RESOURCES_DIR="$CONTENTS_DIR/Resources"
BINARY="$APP_DIR/.build/debug/AgentBoard"
ICON_FILE="$APP_DIR/Resources/AgentBoard.icns"

cd "$APP_DIR"

swift build --disable-sandbox >/dev/null

mkdir -p "$MACOS_DIR" "$RESOURCES_DIR"
rm -f "$MACOS_DIR/AgentBoard" "$MACOS_DIR/AgentBoardBinary"
cp "$BINARY" "$MACOS_DIR/AgentBoardBinary"
if [ -f "$ICON_FILE" ]; then
  cp "$ICON_FILE" "$RESOURCES_DIR/AgentBoard.icns"
fi
AGENT_BOARD_HOME_VALUE="${AGENT_BOARD_HOME:-}"
AGENT_BOARD_INITIAL_PATH_VALUE=""
if [ -n "$INITIAL_PATH" ] && [ "$INITIAL_PATH" != "$APP_DIR" ]; then
  AGENT_BOARD_INITIAL_PATH_VALUE="$INITIAL_PATH"
fi
cat > "$MACOS_DIR/AgentBoard" <<EOF
#!/usr/bin/env bash
set -euo pipefail
if [ -n "$AGENT_BOARD_HOME_VALUE" ]; then
  export AGENT_BOARD_HOME="$AGENT_BOARD_HOME_VALUE"
fi
if [ -n "$AGENT_BOARD_INITIAL_PATH_VALUE" ]; then
  export AGENT_BOARD_INITIAL_PATH="$AGENT_BOARD_INITIAL_PATH_VALUE"
fi
exec "$MACOS_DIR/AgentBoardBinary" "\$@"
EOF
chmod +x "$MACOS_DIR/AgentBoard"

cat > "$CONTENTS_DIR/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleExecutable</key>
  <string>AgentBoard</string>
  <key>CFBundleIdentifier</key>
  <string>dev.agent-board.AgentBoard</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>AgentBoard</string>
  <key>CFBundleIconFile</key>
  <string>AgentBoard</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>0.1.0</string>
  <key>CFBundleVersion</key>
  <string>1</string>
  <key>LSMinimumSystemVersion</key>
  <string>15.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSPrincipalClass</key>
  <string>NSApplication</string>
</dict>
</plist>
PLIST

printf 'APPL????' > "$CONTENTS_DIR/PkgInfo"

exec open -n "$APP_BUNDLE" --args "$@"
